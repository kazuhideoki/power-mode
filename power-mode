#!/usr/bin/env bash
set -euo pipefail

NOLOCK_SCREENSAVER_SECONDS="${NOLOCK_SCREENSAVER_SECONDS:-0}"
NOLOCK_PSEUDO_SCREENSAVER_IDLE_SECONDS="${NOLOCK_PSEUDO_SCREENSAVER_IDLE_SECONDS:-300}"

NORMAL_SLEEP_MINUTES="${NORMAL_SLEEP_MINUTES:-30}"
NORMAL_DISPLAY_SLEEP_MINUTES="${NORMAL_DISPLAY_SLEEP_MINUTES:-20}"
NORMAL_DISK_SLEEP_MINUTES="${NORMAL_DISK_SLEEP_MINUTES:-10}"
NORMAL_SCREENSAVER_SECONDS="${NORMAL_SCREENSAVER_SECONDS:-900}"
NORMAL_PMSET_SCOPE="${NORMAL_PMSET_SCOPE:--a}"

DRY_RUN=0
DETAIL=0
PSEUDO_SCREENSAVER_SECONDS_OVERRIDE=""
PSEUDO_SCREENSAVER_SECONDS_OVERRIDE_SET=0
NOSLEEP_DURATION_MINUTES=""

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PSEUDO_SCREENSAVER_CONTROLLER="${PSEUDO_SCREENSAVER_CONTROLLER:-$script_dir/pseudo_screensaver_control.sh}"
NOSLEEP_TIMEOUT_HELPER="${NOSLEEP_TIMEOUT_HELPER:-$script_dir/nosleep_timeout.sh}"
POWER_MODE_STATE_DIR="${POWER_MODE_STATE_DIR:-$HOME/Library/Caches/power-mode}"
NOSLEEP_STATE_FILE="$POWER_MODE_STATE_DIR/nosleep.state"
AUTOMATIC_POWER_MODE=0
LOW_POWER_MODE=1

usage() {
  cat <<EOF
Usage: $(basename "$0") [setup|nolock|normal|nosleep MINUTES|status] [options]

Modes:
  setup    通常時の電源設定を初回または変更時に反映する（sudo が必要）
  nolock   アイドル時のスリープと標準スクリーンセーバー経由のロックを抑止する
  nosleep  nolock に加え、低電力モードで蓋を閉じた時のスリープも指定時間だけ無効化する（sudo が必要）
  normal   普段使い向け。15 分後にスクリーンセーバー、その後にスリープ/ロックする
  status   現在のモードを表示する（省略時の既定値）

Options:
  --detail
           status の関連設定も表示する
  --pseudo-screensaver-seconds SECONDS
           nolock の擬似スクリーンセーバー起動までの時間を秒で上書きする
  -n, --dry-run
           変更内容だけを表示する

Environment overrides:
  NOLOCK_SCREENSAVER_SECONDS=$NOLOCK_SCREENSAVER_SECONDS
  NOLOCK_PSEUDO_SCREENSAVER_IDLE_SECONDS=$NOLOCK_PSEUDO_SCREENSAVER_IDLE_SECONDS

  NORMAL_SLEEP_MINUTES=$NORMAL_SLEEP_MINUTES
  NORMAL_DISPLAY_SLEEP_MINUTES=$NORMAL_DISPLAY_SLEEP_MINUTES
  NORMAL_DISK_SLEEP_MINUTES=$NORMAL_DISK_SLEEP_MINUTES
  NORMAL_SCREENSAVER_SECONDS=$NORMAL_SCREENSAVER_SECONDS
  NORMAL_PMSET_SCOPE=$NORMAL_PMSET_SCOPE

Notes:
  setup の pmset 変更には sudo が必要です。
  nosleep への切り替えと、時間前に nosleep から抜ける操作には sudo が必要です。
  nolock / normal の切り替えには sudo やパスワード入力は不要です。
  PMSET_SCOPE は -a(all), -c(AC power), -b(battery) のいずれかです。
EOF
}

is_non_negative_integer() {
  case "${1-}" in
  '' | *[!0-9]*) return 1 ;;
  *) return 0 ;;
  esac
}

validate_positive_integer() {
  local name="$1"
  local value="$2"

  validate_non_negative_integer "$name" "$value"
  if [ "$value" -eq 0 ]; then
    echo "$name は1以上の整数で指定してください。" >&2
    exit 1
  fi
}

validate_non_negative_integer() {
  local name="$1"
  local value="$2"

  if ! is_non_negative_integer "$value"; then
    echo "$name は 0 以上の整数で指定してください: $value" >&2
    exit 1
  fi
}

validate_pmset_scope() {
  local name="$1"
  local value="$2"

  case "$value" in
  -a | -b | -c) ;;
  *)
    echo "$name は -a, -b, -c のいずれかで指定してください: $value" >&2
    exit 1
    ;;
  esac
}

ensure_not_root() {
  if [ "${EUID:-$(id -u)}" -eq 0 ]; then
    echo "このスクリプト全体を sudo で実行しないでください。" >&2
    echo "スクリーンセーバー設定が root ユーザー側に書き込まれてしまいます。" >&2
    echo "sudo なしで実行してください。pmset だけ内部で sudo します。" >&2
    exit 1
  fi
}

run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '[DRY] '
    printf '%q ' "$@"
    printf '\n'
    return 0
  fi

  "$@"
}

run_pmset() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '[DRY] '
    if [ "${EUID:-$(id -u)}" -eq 0 ]; then
      printf 'pmset '
    else
      printf 'sudo pmset '
    fi
    printf '%q ' "$@"
    printf '\n'
    return 0
  fi

  if [ "${EUID:-$(id -u)}" -eq 0 ]; then
    pmset "$@"
  else
    sudo pmset "$@"
  fi
}

ensure_pmset_privileges() {
  if [ "$DRY_RUN" -eq 1 ] || [ "${EUID:-$(id -u)}" -eq 0 ]; then
    return 0
  fi

  if sudo -n true 2>/dev/null; then
    return 0
  fi

  if [ -t 0 ]; then
    sudo -v
    return 0
  fi

  echo "pmset の変更には sudo が必要ですが、現在の実行環境には対話 TTY がありません。" >&2
  echo "Terminal など対話可能なシェルから再実行してください: power-mode ${mode:-normal}" >&2
  exit 1
}

flush_user_preferences() {
  if [ "$DRY_RUN" -eq 1 ]; then
    run killall cfprefsd
    return 0
  fi

  killall cfprefsd 2>/dev/null || true
}

read_default() {
  local label="$1"
  shift

  printf '%-36s ' "$label:"
  "$@" 2>/dev/null || printf '(unset)\n'
}

current_power_source() {
  pmset -g batt 2>/dev/null | awk -F"'" '/Now drawing from/ { print $2; exit }'
}

pmset_value() {
  local power_source="$1"
  local key="$2"

  pmset -g custom 2>/dev/null | awk -v source="$power_source" -v key="$key" '
    $0 == source ":" { in_source = 1; next }
    /^[[:alpha:] ].*:$/ { in_source = 0 }
    in_source && $1 == key { print $2; exit }
  '
}

default_value() {
  "$@" 2>/dev/null || true
}

nosleep_state_deadline() {
  sed -n '2p' "$NOSLEEP_STATE_FILE" 2>/dev/null || true
}

sleep_disabled_status() {
  ioreg -r -c IOPMrootDomain -d 1 2>/dev/null | awk -F'= ' '
    /"SleepDisabled"/ {
      gsub(/[[:space:]]/, "", $2)
      print $2
      exit
    }
  '
}

leave_nosleep_if_needed() {
  [ -f "$NOSLEEP_STATE_FILE" ] || return 0

  ensure_pmset_privileges
  run_pmset -a disablesleep 0 powermode "$AUTOMATIC_POWER_MODE"
  if [ "$DRY_RUN" -eq 0 ]; then
    rm -f "$NOSLEEP_STATE_FILE"
  fi
}

screen_lock_status() {
  local output

  output="$(sysadminctl -screenLock status 2>&1 || true)"
  case "$output" in
  *"screenLock is off"*) echo "off" ;;
  *"screenLock delay is immediate"*) echo "immediate" ;;
  *"screenLock delay is "*" seconds"*)
    printf '%s\n' "$output" | sed -n 's/.*screenLock delay is \([0-9][0-9]*\) seconds.*/\1/p' | tail -1
    ;;
  *) echo "unknown" ;;
  esac
}

matches_normal_power_settings() {
  local profile_sleep_minutes="$1"
  local profile_display_sleep_minutes="$2"
  local profile_disk_sleep_minutes="$3"
  local current_sleep_minutes="$4"
  local current_display_sleep_minutes="$5"
  local current_disk_sleep_minutes="$6"

  [ "$current_sleep_minutes" = "$profile_sleep_minutes" ] &&
    [ "$current_display_sleep_minutes" = "$profile_display_sleep_minutes" ] &&
    [ "$current_disk_sleep_minutes" = "$profile_disk_sleep_minutes" ]
}

detect_power_mode() {
  local power_source
  local current_sleep_minutes
  local current_display_sleep_minutes
  local current_disk_sleep_minutes
  local current_screensaver_seconds

  if [ -f "$NOSLEEP_STATE_FILE" ] && [ "$(sleep_disabled_status)" = "Yes" ]; then
    echo "nosleep"
    return 0
  fi

  power_source="$(current_power_source)"
  if [ -z "$power_source" ]; then
    echo "unknown"
    return 0
  fi

  current_sleep_minutes="$(pmset_value "$power_source" sleep)"
  current_display_sleep_minutes="$(pmset_value "$power_source" displaysleep)"
  current_disk_sleep_minutes="$(pmset_value "$power_source" disksleep)"
  current_screensaver_seconds="$(default_value defaults -currentHost read com.apple.screensaver idleTime)"

  if "$PSEUDO_SCREENSAVER_CONTROLLER" status 2>/dev/null | rg -q '^running' &&
    matches_normal_power_settings \
      "$NORMAL_SLEEP_MINUTES" \
      "$NORMAL_DISPLAY_SLEEP_MINUTES" \
      "$NORMAL_DISK_SLEEP_MINUTES" \
      "$current_sleep_minutes" \
      "$current_display_sleep_minutes" \
      "$current_disk_sleep_minutes" &&
    [ "$current_screensaver_seconds" = "$NOLOCK_SCREENSAVER_SECONDS" ]; then
    echo "nolock"
  elif ! "$PSEUDO_SCREENSAVER_CONTROLLER" status 2>/dev/null | rg -q '^running' &&
    matches_normal_power_settings \
      "$NORMAL_SLEEP_MINUTES" \
      "$NORMAL_DISPLAY_SLEEP_MINUTES" \
      "$NORMAL_DISK_SLEEP_MINUTES" \
      "$current_sleep_minutes" \
      "$current_display_sleep_minutes" \
      "$current_disk_sleep_minutes" &&
    [ "$current_screensaver_seconds" = "$NORMAL_SCREENSAVER_SECONDS" ]; then
    echo "normal"
  else
    echo "custom"
  fi
}

print_status() {
  local power_source
  local detected_mode

  detected_mode="$(detect_power_mode)"
  echo "Power mode: $detected_mode"
  [ "$DETAIL" -eq 1 ] || return 0

  power_source="$(current_power_source)"
  if [ -n "$power_source" ]; then
    echo "Power source: $power_source"
  fi
  echo
  echo "pmset:"
  pmset -g custom
  echo
  echo "screensaver:"
  read_default "idleTime(current host)" defaults -currentHost read com.apple.screensaver idleTime
  printf '%-36s %s\n' "screenLock(effective):" "$(screen_lock_status)"
  printf '%-36s ' "pseudoScreenSaver:"
  "$PSEUDO_SCREENSAVER_CONTROLLER" status 2>/dev/null || echo "unknown"
  printf '%-36s %s\n' "sleepDisabled:" "$(sleep_disabled_status)"
  if [ -f "$NOSLEEP_STATE_FILE" ]; then
    printf '%-36s %s\n' "nosleepUntil(epoch):" "$(nosleep_state_deadline)"
  fi
}

apply_mode() {
  local name="$1"
  local screensaver_seconds="$2"
  local success_message="$3"

  validate_non_negative_integer "${name^^}_SCREENSAVER_SECONDS" "$screensaver_seconds"
  if [ "$name" = "nolock" ]; then
    validate_non_negative_integer \
      "NOLOCK_PSEUDO_SCREENSAVER_IDLE_SECONDS" \
      "$NOLOCK_PSEUDO_SCREENSAVER_IDLE_SECONDS"
    if [ "$NOLOCK_PSEUDO_SCREENSAVER_IDLE_SECONDS" -eq 0 ]; then
      echo "NOLOCK_PSEUDO_SCREENSAVER_IDLE_SECONDS は1以上の整数で指定してください。" >&2
      exit 1
    fi
  fi

  run defaults -currentHost write com.apple.screensaver idleTime -int "$screensaver_seconds"
  flush_user_preferences

  case "$name" in
  nolock)
    run "$PSEUDO_SCREENSAVER_CONTROLLER" \
      start "$NOLOCK_PSEUDO_SCREENSAVER_IDLE_SECONDS"
    ;;
  normal)
    run "$PSEUDO_SCREENSAVER_CONTROLLER" stop
    ;;
  esac

  if [ "$DRY_RUN" -eq 0 ] && [ -n "$success_message" ]; then
    echo "$success_message"
  fi
}

apply_setup() {
  validate_pmset_scope "NORMAL_PMSET_SCOPE" "$NORMAL_PMSET_SCOPE"
  validate_non_negative_integer "NORMAL_SLEEP_MINUTES" "$NORMAL_SLEEP_MINUTES"
  validate_non_negative_integer \
    "NORMAL_DISPLAY_SLEEP_MINUTES" \
    "$NORMAL_DISPLAY_SLEEP_MINUTES"
  validate_non_negative_integer "NORMAL_DISK_SLEEP_MINUTES" "$NORMAL_DISK_SLEEP_MINUTES"

  ensure_pmset_privileges
  run_pmset "$NORMAL_PMSET_SCOPE" \
    sleep "$NORMAL_SLEEP_MINUTES" \
    displaysleep "$NORMAL_DISPLAY_SLEEP_MINUTES" \
    disksleep "$NORMAL_DISK_SLEEP_MINUTES"
  apply_mode \
    "normal" \
    "$NORMAL_SCREENSAVER_SECONDS" \
    "Power mode: normal (setup complete)"
}

apply_nosleep() {
  local duration_minutes="$1"
  local duration_seconds
  local deadline
  local token

  validate_positive_integer "nosleep の継続時間（分）" "$duration_minutes"
  duration_seconds=$((duration_minutes * 60))
  ensure_pmset_privileges

  apply_mode \
    "nolock" \
    "$NOLOCK_SCREENSAVER_SECONDS" \
    ""

  if [ "$DRY_RUN" -eq 1 ]; then
    token="dry-run-token"
    run_pmset -a powermode "$LOW_POWER_MODE"
    run_pmset -a disablesleep 1
    run sudo -b "$NOSLEEP_TIMEOUT_HELPER" \
      "$duration_seconds" "$token" "$NOSLEEP_STATE_FILE" \
      "$(id -u)" "$(id -un)" "$HOME" "$script_dir/power-mode"
    return 0
  fi

  mkdir -p "$POWER_MODE_STATE_DIR"
  token="$(uuidgen)"
  deadline="$(($(date +%s) + duration_seconds))"
  printf '%s\n%s\n' "$token" "$deadline" >"$NOSLEEP_STATE_FILE"

  if ! run_pmset -a powermode "$LOW_POWER_MODE"; then
    rm -f "$NOSLEEP_STATE_FILE"
    apply_mode \
      "normal" \
      "$NORMAL_SCREENSAVER_SECONDS" \
      "Power mode: normal (nosleep start failed)"
    echo "低電力モードを有効化できませんでした。" >&2
    exit 1
  fi

  if ! run_pmset -a disablesleep 1; then
    run_pmset -a powermode "$AUTOMATIC_POWER_MODE"
    rm -f "$NOSLEEP_STATE_FILE"
    apply_mode \
      "normal" \
      "$NORMAL_SCREENSAVER_SECONDS" \
      "Power mode: normal (nosleep start failed)"
    echo "蓋を閉じた時のスリープを無効化できませんでした。" >&2
    exit 1
  fi

  if ! sudo -b "$NOSLEEP_TIMEOUT_HELPER" \
    "$duration_seconds" "$token" "$NOSLEEP_STATE_FILE" \
    "$(id -u)" "$(id -un)" "$HOME" "$script_dir/power-mode"; then
    run_pmset -a disablesleep 0 powermode "$AUTOMATIC_POWER_MODE"
    rm -f "$NOSLEEP_STATE_FILE"
    apply_mode \
      "normal" \
      "$NORMAL_SCREENSAVER_SECONDS" \
      "Power mode: normal (nosleep start failed)"
    echo "nosleep の自動復帰タイマーを開始できませんでした。" >&2
    exit 1
  fi

  echo "Power mode: nosleep (${duration_minutes}m)"
}

mode=""
while [ $# -gt 0 ]; do
  case "$1" in
  setup | nolock | normal | nosleep | status)
    if [ -n "$mode" ]; then
      echo "mode は1つだけ指定してください: $mode と $1" >&2
      usage >&2
      exit 1
    fi
    mode="$1"
    shift
    if [ "$mode" = "nosleep" ]; then
      if [ $# -eq 0 ] || [[ "$1" = -* ]]; then
        echo "nosleep には継続時間（分）が必要です。" >&2
        usage >&2
        exit 1
      fi
      NOSLEEP_DURATION_MINUTES="$1"
      shift
    fi
    ;;
  -n | --dry-run)
    DRY_RUN=1
    shift
    ;;
  --detail)
    DETAIL=1
    shift
    ;;
  --pseudo-screensaver-seconds)
    if [ $# -lt 2 ]; then
      echo "--pseudo-screensaver-seconds には秒数が必要です。" >&2
      usage >&2
      exit 1
    fi
    if [ "$PSEUDO_SCREENSAVER_SECONDS_OVERRIDE_SET" -eq 1 ]; then
      echo "--pseudo-screensaver-seconds は1回だけ指定してください。" >&2
      usage >&2
      exit 1
    fi
    PSEUDO_SCREENSAVER_SECONDS_OVERRIDE="$2"
    PSEUDO_SCREENSAVER_SECONDS_OVERRIDE_SET=1
    shift 2
    ;;
  --pseudo-screensaver-seconds=*)
    if [ "$PSEUDO_SCREENSAVER_SECONDS_OVERRIDE_SET" -eq 1 ]; then
      echo "--pseudo-screensaver-seconds は1回だけ指定してください。" >&2
      usage >&2
      exit 1
    fi
    PSEUDO_SCREENSAVER_SECONDS_OVERRIDE="${1#*=}"
    PSEUDO_SCREENSAVER_SECONDS_OVERRIDE_SET=1
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "未知のオプション: $1" >&2
    usage >&2
    exit 1
    ;;
  esac
done

mode="${mode:-status}"

if [ "$DETAIL" -eq 1 ] && [ "$mode" != "status" ]; then
  echo "--detail は status でのみ指定できます。" >&2
  usage >&2
  exit 1
fi

if [ "$PSEUDO_SCREENSAVER_SECONDS_OVERRIDE_SET" -eq 1 ]; then
  if [ "$mode" != "nolock" ]; then
    echo "--pseudo-screensaver-seconds は nolock でのみ指定できます。" >&2
    usage >&2
    exit 1
  fi
  validate_non_negative_integer \
    "--pseudo-screensaver-seconds" \
    "$PSEUDO_SCREENSAVER_SECONDS_OVERRIDE"
  if [ "$PSEUDO_SCREENSAVER_SECONDS_OVERRIDE" -eq 0 ]; then
    echo "--pseudo-screensaver-seconds は1以上の整数で指定してください。" >&2
    exit 1
  fi
  NOLOCK_PSEUDO_SCREENSAVER_IDLE_SECONDS="$PSEUDO_SCREENSAVER_SECONDS_OVERRIDE"
fi

ensure_not_root

case "$mode" in
setup)
  leave_nosleep_if_needed
  apply_setup
  ;;
nolock)
  leave_nosleep_if_needed
  apply_mode \
    "nolock" \
    "$NOLOCK_SCREENSAVER_SECONDS" \
    "Power mode: nolock"
  ;;
normal)
  leave_nosleep_if_needed
  apply_mode \
    "normal" \
    "$NORMAL_SCREENSAVER_SECONDS" \
    "Power mode: normal"
  ;;
nosleep)
  apply_nosleep "$NOSLEEP_DURATION_MINUTES"
  ;;
status)
  print_status
  ;;
*)
  echo "未知の mode: $mode" >&2
  usage >&2
  exit 1
  ;;
esac
